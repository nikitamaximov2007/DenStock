# DenisStock emergency-local. Copy to .env.emergency and replace every placeholder.
# This file contains no production database credentials.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=REPLACE-WITH-A-LOCAL-RANDOM-SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,emergency-web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_COOKIES=false
TIME_ZONE=Europe/Moscow

# Dedicated local PostgreSQL 16 only. Keep the emergency prefix.
POSTGRES_DB=denstock_emergency_control
POSTGRES_USER=denstock_emergency
POSTGRES_PASSWORD=REPLACE-WITH-A-LOCAL-URL-SAFE-PASSWORD
DATABASE_URL=postgresql://denstock_emergency:REPLACE-WITH-A-LOCAL-URL-SAFE-PASSWORD@emergency-db:5432/denstock_emergency_control

DENSTOCK_MODE=emergency-local
DENSTOCK_INSTANCE_ID=warehouse-pc-01
# Installer creates this stable identity once in protected .emergency storage.
DENSTOCK_EMERGENCY_WORKSTATION_ID=REPLACE-WITH-PROVISIONED-WORKSTATION-UUID
DENSTOCK_EMERGENCY_WORKSTATION_ID_PATH=/app/.emergency/workstation-id.txt
# This is a pinned production public key inside protected local runtime storage.
# Never place a production private signing key on the workstation.
DENSTOCK_MANIFEST_PUBLIC_KEY_PATH=/app/.emergency/trusted/production-manifest-ed25519-public.pem
DENSTOCK_MANIFEST_SIGNING_KEY_ID=REPLACE-WITH-PRODUCTION-KEY-ID
DENSTOCK_APP_COMMIT=REPLACE-WITH-DEPLOYED-GIT-COMMIT
DENSTOCK_EMERGENCY_DB_PREFIX=denstock_emergency_
DENSTOCK_EMERGENCY_ALLOWED_DB_HOSTS=emergency-db,localhost,127.0.0.1
DENSTOCK_PRODUCTION_DB_HOSTS=185.250.44.206,db
DENSTOCK_EMERGENCY_STALE_WARNING_HOURS=24
DENSTOCK_EMERGENCY_KEEP_STANDBY=2
DENSTOCK_EMERGENCY_KEEP_DOWNLOADS=2
DENSTOCK_EMERGENCY_KEEP_COMPLETED_EXPORTS=2
# Only a primary is permitted to activate. A replacement workstation must start as secondary.
DENSTOCK_EMERGENCY_ROLE=primary
# Default is localhost. Provisioning sets the fixed Primary LAN address only after validation.
DENSTOCK_EMERGENCY_BIND_HOST=127.0.0.1
DENSTOCK_EMERGENCY_PORT=8080

# Offsite rclone path, for example yandex:denstock-backups.
# The rclone credentials remain in the Windows user profile, never in this file.
DENSTOCK_EMERGENCY_BACKUP_SOURCE=REPLACE-WITH-RCLONE-REMOTE-OR-LOCAL-PATH
# Git remote or local bare repository containing every approved production release.
# It is used only to fetch the exact manifest app_commit before a standby refresh.
DENSTOCK_EMERGENCY_RELEASE_SOURCE=REPLACE-WITH-APPROVED-GIT-REMOTE

# Read-only production comparison. This token must equal the production secret.
DENSTOCK_PRODUCTION_URL=https://185-250-44-206.sslip.io
DENSTOCK_EMERGENCY_PROBE_TOKEN=REPLACE-WITH-A-RANDOM-SHARED-PROBE-TOKEN

AI_SUPPORT_ENABLED=false
AI_SUPPORT_PROVIDER=disabled
