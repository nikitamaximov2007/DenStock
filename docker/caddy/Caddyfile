# Локально: слушаем :80 и проксируем на Django.
# На VPS: задайте CADDY_SITE_ADDRESS=ваш-домен — Caddy включит авто-HTTPS.
{$CADDY_SITE_ADDRESS::80} {
	encode gzip

	# A separate hostname reaches only the restricted catalog-web process.
	# The service is launched with the public-catalog compose profile.
	@public_catalog host {$CADDY_PUBLIC_CATALOG_HOST:catalog.localhost}
	handle @public_catalog {
		reverse_proxy catalog-web:8000
	}

	# Слой 25: статичная отдача загруженных media-файлов из общего тома (read-only).
	# /media/part-items/… → /srv/media/part-items/…
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Остальное — в Django.
	handle {
		reverse_proxy web:8000
	}
}
