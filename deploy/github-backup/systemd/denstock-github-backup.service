# Daily encrypted copy of the newest verified backup to GitHub Releases.
# Install: docs/operations/github-release-backups.md (needs owner approval).
[Unit]
Description=DenisStock: encrypted backup copy to GitHub Releases
After=denstock-backup.service network-online.target
Wants=network-online.target
OnFailure=denstock-github-backup-alert.service

[Service]
Type=oneshot
Environment=GHB_CONFIG=/etc/denstock/github-backup.env
# Ciphertext is staged outside /opt/denstock/backups, so the nightly wrapper and
# backup_all rotation never see it. systemd creates the directory 0700.
Environment=GHB_WORK_DIR=/var/lib/denstock-github-backup
StateDirectory=denstock-github-backup
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/denstock/github_release_backup.py push
# 75 = another run still holds the lock: not a failure.
SuccessExitStatus=75
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/denstock/backups /run/lock
